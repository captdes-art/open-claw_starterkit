<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.openclaw.rescue</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>YOUR_WORKSPACE_PATH/scripts/telegram-rescue.py</string>
  </array>
  <key>StartInterval</key>
  <integer>120</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>YOUR_HOME/.openclaw/logs/rescue-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>YOUR_HOME/.openclaw/logs/rescue-launchd-err.log</string>
</dict>
</plist>
